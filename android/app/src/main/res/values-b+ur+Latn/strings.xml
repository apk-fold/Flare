    <string name="rights_intro">Kuch aur ijazaton ke saath Flare bohat zyada kar sakta hai. Sirf wohi dein jo aap ki automations ko chahiye: sab kuch aap ke phone par hi rehta hai.</string>
    <string name="r_shizuku">Shizuku (ADB huqooq, baghair root)</string>
    <string name="r_shizuku_desc">Wi-Fi, mobile data, Bluetooth, airplane mode, dark mode aur power saving on/off karta hai, aur commands chalata hai. Wireless debugging se Shizuku shuru karein, phir Flare ko ijazat dein.</string>
    <string name="r_grant_all">Sab aik saath dein</string>
    <string name="r_grant_all_desc">Shizuku ke saath Flare neeche ki tamam ijazatein, mustaqil system huqooq samet, khud ko de deta hai, har screen par jaye baghair.</string>
    <string name="btn_grant_all">Sab dein</string>
    <string name="grant_all_needs_shizuku">Pehle Shizuku shuru karein aur Flare ko ijazat dein.</string>
    <string name="grant_all_done">Mukammal: %2$d mein se %1$d di gayin</string>
    <string name="r_secure">Mustaqil system huqooq</string>
    <string name="r_secure_desc">Flare ko mehfooz settings badalne deta hai chahe Shizuku band ho (restart ke baad), aur apni accessibility service khud dobara chalane deta hai. Shizuku ke baghair, computer se:</string>
    <string name="r_accessibility">Accessibility service</string>
    <string name="r_accessibility_desc">Screen par app pehchanta hai, screen lock karta hai, screenshot leta hai, system buttons dabata hai aur aap ki jagah screen ko chhoota hai.</string>
    <string name="r_restricted_hint">Grey hai? App info kholein, phir ⋮ › Restricted settings ki ijazat dein.</string>
    <string name="r_notif_listener">Notification access</string>
    <string name="r_notif_listener_desc">\"Notification mili\" trigger, kisi bhi app mein music chalana, notifications saaf karna.</string>
    <string name="r_write_settings">System settings badalna</string>
    <string name="r_write_settings_desc">Brightness, screen timeout, auto-rotate.</string>
    <string name="r_dnd">Do Not Disturb access</string>
    <string name="r_dnd_desc">Do Not Disturb, silent aur vibrate modes.</string>
    <string name="r_overlay">Doosri apps ke upar dikhana</string>
    <string name="r_overlay_desc">Flare ko background mein chalte hue apps (Maps, music…) kholne deta hai.</string>
    <string name="r_battery">Battery ki koi pabandi nahin</string>
    <string name="r_battery_desc">Phone ko Flare sulane se rokta hai. Samsung par app ki battery settings mein Flare ko \"Unrestricted\" bhi karein.</string>
    <string name="r_alarms">Alarms aur reminders</string>
    <string name="r_alarms_desc">Minute tak durust waqt ke triggers.</string>
    <string name="r_runtime">Bluetooth, location, phone, SMS, notifications</string>
    <string name="r_runtime_desc">Jab kisi automation ko zaroorat ho to khud maangi jati hain.</string>
    <string name="r_bg_location">Har waqt location</string>
    <string name="r_bg_location_desc">Background mein jagah ke triggers aur Wi-Fi network ka naam.</string>
