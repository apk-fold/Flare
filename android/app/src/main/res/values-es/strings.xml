    <string name="rights_intro">Flare puede hacer mucho más con algunos permisos extra. Concede solo lo que necesiten tus automatizaciones: todo se queda en tu teléfono.</string>
    <string name="r_shizuku">Shizuku (permisos ADB, sin root)</string>
    <string name="r_shizuku_desc">Activa o desactiva el Wi-Fi, los datos móviles, el Bluetooth, el modo avión, el modo oscuro y el ahorro de energía, y ejecuta comandos. Inicia Shizuku con la depuración inalámbrica y luego autoriza a Flare.</string>
    <string name="r_grant_all">Concederlo todo de una vez</string>
    <string name="r_grant_all_desc">Con Shizuku, Flare se concede a sí mismo todos los permisos de abajo, incluidos los permisos de sistema permanentes, sin pasar por cada pantalla.</string>
    <string name="btn_grant_all">Concederlo todo</string>
    <string name="grant_all_needs_shizuku">Inicia primero Shizuku y autoriza a Flare.</string>
    <string name="grant_all_done">Listo: %1$d de %2$d concedidos</string>
    <string name="r_secure">Permisos de sistema permanentes</string>
    <string name="r_secure_desc">Permite a Flare cambiar ajustes protegidos aunque Shizuku esté detenido (tras reiniciar) y volver a activar por sí mismo su servicio de accesibilidad. Sin Shizuku, desde un ordenador:</string>
    <string name="r_accessibility">Servicio de accesibilidad</string>
    <string name="r_accessibility_desc">Detecta la app en pantalla, bloquea la pantalla, hace capturas, pulsa los botones del sistema y toca la pantalla por ti.</string>
    <string name="r_restricted_hint">¿Aparece en gris? Abre Información de la app y luego ⋮ › Permitir ajustes restringidos.</string>
    <string name="r_notif_listener">Acceso a las notificaciones</string>
    <string name="r_notif_listener_desc">Activador «notificación recibida», reproducir música en cualquier app, borrar notificaciones.</string>
    <string name="r_write_settings">Modificar ajustes del sistema</string>
    <string name="r_write_settings_desc">Brillo, tiempo de espera de la pantalla, giro automático.</string>
    <string name="r_dnd">Acceso a No molestar</string>
    <string name="r_dnd_desc">No molestar, modos silencio y vibración.</string>
    <string name="r_overlay">Mostrar sobre otras apps</string>
    <string name="r_overlay_desc">Permite a Flare abrir apps (Maps, música…) mientras funciona en segundo plano.</string>
    <string name="r_battery">Sin restricciones de batería</string>
    <string name="r_battery_desc">Evita que el teléfono duerma a Flare. En Samsung, pon además Flare en «Sin restricciones» en los ajustes de batería de la app.</string>
    <string name="r_alarms">Alarmas y recordatorios</string>
    <string name="r_alarms_desc">Activadores horarios al minuto exacto.</string>
