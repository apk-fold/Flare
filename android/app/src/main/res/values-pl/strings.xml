    <string name="rights_intro">Z kilkoma dodatkowymi uprawnieniami Flare potrafi znacznie więcej. Przyznaj tylko to, czego potrzebują twoje automatyzacje: wszystko zostaje w telefonie.</string>
    <string name="r_shizuku">Shizuku (uprawnienia ADB, bez roota)</string>
    <string name="r_shizuku_desc">Włącza i wyłącza Wi-Fi, dane mobilne, Bluetooth, tryb samolotowy, tryb ciemny i oszczędzanie energii oraz uruchamia polecenia. Uruchom Shizuku przez debugowanie bezprzewodowe, a potem zezwól Flare.</string>
    <string name="r_grant_all">Przyznaj wszystko naraz</string>
    <string name="r_grant_all_desc">Dzięki Shizuku Flare sam przyznaje sobie wszystkie uprawnienia poniżej, łącznie ze stałymi uprawnieniami systemowymi, bez przechodzenia przez każdy ekran.</string>
    <string name="btn_grant_all">Przyznaj wszystko</string>
    <string name="grant_all_needs_shizuku">Najpierw uruchom Shizuku i zezwól Flare.</string>
    <string name="grant_all_done">Gotowe: przyznano %1$d z %2$d</string>
    <string name="r_secure">Stałe uprawnienia systemowe</string>
    <string name="r_secure_desc">Pozwalają Flare zmieniać chronione ustawienia nawet przy zatrzymanym Shizuku (po ponownym uruchomieniu) i samodzielnie włączać z powrotem swoją usługę ułatwień dostępu. Bez Shizuku, z komputera:</string>
    <string name="r_accessibility">Usługa ułatwień dostępu</string>
    <string name="r_accessibility_desc">Rozpoznaje aplikację na ekranie, blokuje ekran, robi zrzuty ekranu, naciska przyciski systemowe i dotyka ekranu za ciebie.</string>
    <string name="r_restricted_hint">Wyszarzone? Otwórz Informacje o aplikacji, a potem ⋮ › Zezwól na ustawienia z ograniczonym dostępem.</string>
    <string name="r_notif_listener">Dostęp do powiadomień</string>
    <string name="r_notif_listener_desc">Wyzwalacz „otrzymano powiadomienie”, muzyka w dowolnej aplikacji, czyszczenie powiadomień.</string>
    <string name="r_write_settings">Modyfikowanie ustawień systemu</string>
    <string name="r_write_settings_desc">Jasność, wygaszanie ekranu, autoobracanie.</string>
    <string name="r_dnd">Dostęp do trybu Nie przeszkadzać</string>
    <string name="r_dnd_desc">Nie przeszkadzać, tryb cichy i wibracje.</string>
    <string name="r_overlay">Wyświetlanie nad innymi aplikacjami</string>
    <string name="r_overlay_desc">Pozwala Flare otwierać aplikacje (Mapy, muzykę…), gdy działa w tle.</string>
    <string name="r_battery">Bez ograniczeń baterii</string>
    <string name="r_battery_desc">Nie pozwala telefonowi usypiać Flare. Na Samsungu ustaw też Flare na „Bez ograniczeń” w ustawieniach baterii aplikacji.</string>
    <string name="r_alarms">Alarmy i przypomnienia</string>
