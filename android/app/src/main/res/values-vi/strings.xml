    <string name="rights_intro">Với thêm vài quyền, Flare có thể làm được nhiều hơn. Chỉ cấp những gì tự động hóa của bạn cần: mọi thứ đều ở trên điện thoại.</string>
    <string name="r_shizuku">Shizuku (quyền ADB, không cần root)</string>
    <string name="r_shizuku_desc">Bật hoặc tắt Wi-Fi, dữ liệu di động, Bluetooth, chế độ máy bay, chế độ tối và tiết kiệm pin, đồng thời chạy lệnh. Khởi động Shizuku bằng gỡ lỗi không dây, rồi cho phép Flare.</string>
    <string name="r_grant_all">Cấp tất cả một lần</string>
    <string name="r_grant_all_desc">Với Shizuku, Flare tự cấp cho mình mọi quyền bên dưới, kể cả quyền hệ thống vĩnh viễn, mà không cần mở từng màn hình.</string>
    <string name="btn_grant_all">Cấp tất cả</string>
    <string name="grant_all_needs_shizuku">Hãy khởi động Shizuku và cho phép Flare trước.</string>
    <string name="grant_all_done">Xong: đã cấp %1$d trên %2$d</string>
    <string name="r_secure">Quyền hệ thống vĩnh viễn</string>
    <string name="r_secure_desc">Cho phép Flare thay đổi cài đặt được bảo vệ ngay cả khi Shizuku dừng (sau khi khởi động lại) và tự bật lại dịch vụ hỗ trợ tiếp cận. Không có Shizuku, từ máy tính:</string>
    <string name="r_accessibility">Dịch vụ hỗ trợ tiếp cận</string>
    <string name="r_accessibility_desc">Nhận biết ứng dụng trên màn hình, khóa màn hình, chụp màn hình, nhấn nút hệ thống và chạm màn hình thay bạn.</string>
    <string name="r_restricted_hint">Bị mờ? Mở Thông tin ứng dụng, rồi ⋮ › Cho phép chế độ cài đặt bị hạn chế.</string>
    <string name="r_notif_listener">Quyền truy cập thông báo</string>
    <string name="r_notif_listener_desc">Bộ kích hoạt \"nhận thông báo\", phát nhạc trong mọi ứng dụng, xóa thông báo.</string>
    <string name="r_write_settings">Sửa đổi cài đặt hệ thống</string>
    <string name="r_write_settings_desc">Độ sáng, thời gian chờ màn hình, tự động xoay.</string>
    <string name="r_dnd">Quyền Không làm phiền</string>
    <string name="r_dnd_desc">Không làm phiền, chế độ im lặng và rung.</string>
    <string name="r_overlay">Hiển thị trên ứng dụng khác</string>
    <string name="r_overlay_desc">Cho phép Flare mở ứng dụng (Maps, nhạc…) khi đang chạy nền.</string>
    <string name="r_battery">Không giới hạn pin</string>
    <string name="r_battery_desc">Ngăn điện thoại cho Flare ngủ. Trên Samsung, hãy đặt thêm Flare là \"Không hạn chế\" trong cài đặt pin của ứng dụng.</string>
    <string name="r_alarms">Báo thức và lời nhắc</string>
    <string name="r_alarms_desc">Bộ kích hoạt theo giờ chính xác đến từng phút.</string>
    <string name="r_runtime">Bluetooth, vị trí, điện thoại, SMS, thông báo</string>
