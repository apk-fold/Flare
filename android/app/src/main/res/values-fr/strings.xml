    <string name="rights_intro">Flare peut faire beaucoup plus avec quelques autorisations en plus. N\'accorde que ce dont tes automatisations ont besoin : tout reste sur ton téléphone.</string>
    <string name="r_shizuku">Shizuku (droits ADB, sans root)</string>
    <string name="r_shizuku_desc">Active ou coupe le Wi-Fi, les données mobiles, le Bluetooth, le mode avion, le mode sombre et l\'économie d\'énergie, et lance des commandes. Démarre Shizuku avec le débogage sans fil, puis autorise Flare.</string>
    <string name="r_grant_all">Tout accorder d\'un coup</string>
    <string name="r_grant_all_desc">Avec Shizuku, Flare s\'accorde lui-même toutes les autorisations ci-dessous, droits système permanents compris, sans passer par chaque écran.</string>
    <string name="btn_grant_all">Tout accorder</string>
    <string name="grant_all_needs_shizuku">Démarre d\'abord Shizuku et autorise Flare.</string>
    <string name="grant_all_done">Terminé : %1$d sur %2$d accordés</string>
    <string name="r_secure">Droits système permanents</string>
    <string name="r_secure_desc">Permet à Flare de modifier les réglages protégés même quand Shizuku est arrêté (après un redémarrage), et de réactiver tout seul son service d\'accessibilité. Sans Shizuku, depuis un ordinateur :</string>
    <string name="r_accessibility">Service d\'accessibilité</string>
    <string name="r_accessibility_desc">Détecte l\'appli à l\'écran, verrouille l\'écran, fait des captures, appuie sur les boutons système et touche l\'écran à ta place.</string>
    <string name="r_restricted_hint">Grisé ? Ouvre Infos sur l\'appli, puis ⋮ › Autoriser les paramètres restreints.</string>
    <string name="r_notif_listener">Accès aux notifications</string>
    <string name="r_notif_listener_desc">Déclencheur « notification reçue », lecture de musique dans n\'importe quelle appli, effacement des notifications.</string>
    <string name="r_write_settings">Modifier les paramètres système</string>
    <string name="r_write_settings_desc">Luminosité, mise en veille de l\'écran, rotation automatique.</string>
    <string name="r_dnd">Accès à Ne pas déranger</string>
    <string name="r_dnd_desc">Ne pas déranger, modes silencieux et vibreur.</string>
    <string name="r_overlay">Affichage par-dessus les autres applis</string>
    <string name="r_overlay_desc">Permet à Flare d\'ouvrir des applis (Maps, musique…) quand il tourne en arrière-plan.</string>
    <string name="r_battery">Aucune restriction de batterie</string>
    <string name="r_battery_desc">Empêche le téléphone d\'endormir Flare. Sur Samsung, mets aussi Flare sur « Non restreinte » dans les réglages de batterie de l\'appli.</string>
    <string name="r_alarms">Alarmes et rappels</string>
