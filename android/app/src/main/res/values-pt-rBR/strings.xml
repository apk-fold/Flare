    <string name="rights_intro">O Flare pode fazer muito mais com algumas permissões extras. Conceda só o que suas automações precisam: tudo fica no seu celular.</string>
    <string name="r_shizuku">Shizuku (permissões ADB, sem root)</string>
    <string name="r_shizuku_desc">Liga ou desliga Wi-Fi, dados móveis, Bluetooth, modo avião, tema escuro e economia de energia, e executa comandos. Inicie o Shizuku pela depuração sem fio e depois autorize o Flare.</string>
    <string name="r_grant_all">Conceder tudo de uma vez</string>
    <string name="r_grant_all_desc">Com o Shizuku, o Flare concede a si mesmo todas as permissões abaixo, incluindo as permissões de sistema permanentes, sem passar por cada tela.</string>
    <string name="btn_grant_all">Conceder tudo</string>
    <string name="grant_all_needs_shizuku">Inicie o Shizuku e autorize o Flare primeiro.</string>
    <string name="grant_all_done">Pronto: %1$d de %2$d concedidas</string>
    <string name="r_secure">Permissões de sistema permanentes</string>
    <string name="r_secure_desc">Permite que o Flare altere configurações protegidas mesmo com o Shizuku parado (depois de reiniciar) e reative sozinho o serviço de acessibilidade. Sem Shizuku, a partir de um computador:</string>
    <string name="r_accessibility">Serviço de acessibilidade</string>
    <string name="r_accessibility_desc">Detecta o app na tela, bloqueia a tela, faz capturas, aperta os botões do sistema e toca na tela por você.</string>
    <string name="r_restricted_hint">Está em cinza? Abra Informações do app e depois ⋮ › Permitir configurações restritas.</string>
    <string name="r_notif_listener">Acesso às notificações</string>
    <string name="r_notif_listener_desc">Gatilho \"notificação recebida\", tocar música em qualquer app, limpar notificações.</string>
    <string name="r_write_settings">Modificar configurações do sistema</string>
    <string name="r_write_settings_desc">Brilho, tempo limite da tela, giro automático.</string>
    <string name="r_dnd">Acesso ao Não perturbe</string>
    <string name="r_dnd_desc">Não perturbe, modos silencioso e vibrar.</string>
    <string name="r_overlay">Sobrepor a outros apps</string>
    <string name="r_overlay_desc">Permite que o Flare abra apps (Maps, música…) enquanto roda em segundo plano.</string>
    <string name="r_battery">Sem restrições de bateria</string>
    <string name="r_battery_desc">Impede que o celular coloque o Flare para dormir. Na Samsung, coloque também o Flare em \"Sem restrições\" nas configurações de bateria do app.</string>
    <string name="r_alarms">Alarmes e lembretes</string>
    <string name="r_alarms_desc">Gatilhos de horário no minuto exato.</string>
    <string name="r_runtime">Bluetooth, localização, telefone, SMS, notificações</string>
    <string name="r_runtime_desc">Pedidos automaticamente quando uma automação precisa deles.</string>
    <string name="r_bg_location">Localização o tempo todo</string>
    <string name="r_bg_location_desc">Gatilhos de lugar e nome da rede Wi-Fi em segundo plano.</string>
