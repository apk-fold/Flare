    <string name="rights_intro">Con qualche permesso in più Flare può fare molto di più. Concedi solo ciò che serve alle tue automazioni: tutto resta sul tuo telefono.</string>
    <string name="r_shizuku">Shizuku (permessi ADB, senza root)</string>
    <string name="r_shizuku_desc">Attiva o disattiva Wi-Fi, dati mobili, Bluetooth, modalità aereo, tema scuro e risparmio energetico, ed esegue comandi. Avvia Shizuku con il debug wireless, poi autorizza Flare.</string>
    <string name="r_grant_all">Concedi tutto in un colpo</string>
    <string name="r_grant_all_desc">Con Shizuku, Flare si concede da solo tutti i permessi qui sotto, compresi i permessi di sistema permanenti, senza passare da ogni schermata.</string>
    <string name="btn_grant_all">Concedi tutto</string>
    <string name="grant_all_needs_shizuku">Avvia prima Shizuku e autorizza Flare.</string>
    <string name="grant_all_done">Fatto: %1$d su %2$d concessi</string>
    <string name="r_secure">Permessi di sistema permanenti</string>
    <string name="r_secure_desc">Permette a Flare di modificare le impostazioni protette anche quando Shizuku è fermo (dopo un riavvio) e di riattivare da solo il suo servizio di accessibilità. Senza Shizuku, da un computer:</string>
    <string name="r_accessibility">Servizio di accessibilità</string>
    <string name="r_accessibility_desc">Rileva l\'app sullo schermo, blocca lo schermo, fa screenshot, preme i tasti di sistema e tocca lo schermo al posto tuo.</string>
    <string name="r_restricted_hint">In grigio? Apri Informazioni app, poi ⋮ › Consenti impostazioni con limitazioni.</string>
    <string name="r_notif_listener">Accesso alle notifiche</string>
    <string name="r_notif_listener_desc">Attivatore «notifica ricevuta», riproduzione di musica in qualsiasi app, cancellazione delle notifiche.</string>
    <string name="r_write_settings">Modifica impostazioni di sistema</string>
    <string name="r_write_settings_desc">Luminosità, spegnimento dello schermo, rotazione automatica.</string>
    <string name="r_dnd">Accesso a Non disturbare</string>
    <string name="r_dnd_desc">Non disturbare, modalità silenziosa e vibrazione.</string>
    <string name="r_overlay">Mostra sopra altre app</string>
    <string name="r_overlay_desc">Permette a Flare di aprire app (Maps, musica…) mentre funziona in background.</string>
    <string name="r_battery">Nessuna restrizione della batteria</string>
    <string name="r_battery_desc">Impedisce al telefono di addormentare Flare. Su Samsung imposta anche Flare su «Senza restrizioni» nelle impostazioni batteria dell\'app.</string>
    <string name="r_alarms">Sveglie e promemoria</string>
    <string name="r_alarms_desc">Attivatori orari al minuto esatto.</string>
    <string name="r_runtime">Bluetooth, posizione, telefono, SMS, notifiche</string>
